# Codabench credentials for tools/codabench_submit.py
# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Your Codabench login (email works as the username):
CODABENCH_USERNAME=you@example.com
CODABENCH_PASSWORD=your-password

# Alternative to username/password: a DRF auth token (skips the login step).
# Get it from the Codabench API once, then paste here. If set, it takes priority.
# CODABENCH_TOKEN=

# Optional: point the loader at a different env file.
# CODABENCH_ENV_FILE=/path/to/other.env
